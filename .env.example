# Database
DATABASE_URL=postgresql://importacao:importacao123@localhost:5432/importacao
POSTGRES_USER=importacao
POSTGRES_PASSWORD=importacao123
POSTGRES_DB=importacao

# JWT
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# API
API_PORT=3001
NODE_ENV=development

# ── AI provider ──
# 'ialocal'  (IA_LOCAL — plataforma self-hosted on-prem, sem egress, sem API paga;
#             ver repo IA_LOCAL. Recomendado p/ documentos sensíveis.)
# 'vertex'   (Google Vertex AI — garantia contratual de NÃO-treinamento nos dados.)
# 'openrouter' (externo — NÃO usar com dado sensível sem opt-in formal.)
AI_PROVIDER=ialocal
AI_ALLOW_EXTERNAL=false

# Teto de custo mensal da IA em USD (0 = sem teto). USD 26 ≈ R$150 a ~5.7 BRL/USD.
AI_MONTHLY_BUDGET_USD=26

# Vertex AI (quando AI_PROVIDER=vertex)
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
# SA dedicada com role roles/aiplatform.user (cai p/ GOOGLE_DRIVE_* se vazio).
# Habilitar a API e conceder o role (uma vez, no GCP):
#   gcloud services enable aiplatform.googleapis.com --project=SEU_PROJETO
#   gcloud projects add-iam-policy-binding SEU_PROJETO \
#     --member=serviceAccount:vertex-sa@SEU_PROJETO.iam.gserviceaccount.com \
#     --role=roles/aiplatform.user
GOOGLE_VERTEX_CLIENT_EMAIL=vertex-sa@your-project.iam.gserviceaccount.com
GOOGLE_VERTEX_PRIVATE_KEY=your-private-key

# OpenRouter (quando AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# IA_LOCAL (quando AI_PROVIDER=ialocal) — gateway OpenAI-compatible do repo IA_LOCAL.
# Modelo local é grátis: não consome AI_MONTHLY_BUDGET_USD. Extração é por IMAGEM,
# então use um VLM da família qwen3: qwen3-vl:4b (CPU) / qwen3-vl:8b (GPU) /
# qwen3-vl:2b (CPU se latência apertar). qwen3 puro é TEXTO e não lê a imagem.
# Recomendado: o build especialista 'unico-docintel' (ver repo IA_LOCAL). O token
# é o COPILOTO_GATEWAY_TOKEN do IA_LOCAL.
# SEGURANÇA (premissa): http:// só é aceitável enquanto SINGLE-HOST + ia-local-net
# isolada + gateway SEM porta publicada no host. Nesse cenário o "fio" é a bridge
# Docker no mesmo kernel (sniffar exige root no host, onde TLS não salvaria). No
# momento em que o tráfego cruzar host/VLAN/overlay multi-host, habilite TLS
# (`tls internal` no Caddy do gateway), use https:// e confie na CA via
# NODE_EXTRA_CA_CERTS — NUNCA rejectUnauthorized=false.
IA_LOCAL_BASE_URL=http://ia-local-gateway:8443/v1
IA_LOCAL_API_KEY=your-ia-local-gateway-token
IA_LOCAL_MODEL=unico-docintel
# Modelo de embeddings p/ o RAG (recupera conhecimento de domínio p/ injetar no
# prompt). bge-m3 (1024 dim) é o que o IA_LOCAL já baixa no bootstrap.
IA_LOCAL_EMBED_MODEL=bge-m3
IA_LOCAL_ALLOWED_HOSTS=ia-local-gateway
IA_LOCAL_NUM_PREDICT=1536
IA_LOCAL_NUM_CTX=8192
# Pipeline especialista (constituição + skills + RAG + defesa anti-injeção).
# Default on no provider local para documentos sensíveis.
AI_USE_SPECIALIST=1
# Timeouts por chamada ao modelo. Extração roda fora do request HTTP, então o
# local (CPU lento) ganha um teto bem maior.
AI_CHAT_TIMEOUT_MS=90000
AI_LOCAL_CHAT_TIMEOUT_MS=180000
# Timeout global por documento: se OCR/IA travar, a extração vira falha
# operacional explícita em vez de deixar a UI processando indefinidamente.
DOCUMENT_AI_EXTRACTION_TIMEOUT_MS=180000
# Depois desse tempo, documento ainda nao processado passa a ser exibido como erro
# operacional para parar polling infinito e liberar reprocessamento.
DOCUMENT_PROCESSING_STALE_MINUTES=30

# Google Drive
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=your-private-key
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id
# ID da pasta do Drive com a planilha Pre-Cons. A pasta precisa estar
# compartilhada (Viewer) com a SA em GOOGLE_DRIVE_CLIENT_EMAIL, senão a
# sync de Pre-Cons (*/6h) é pulada silenciosamente.
GOOGLE_DRIVE_PRE_CONS_FOLDER_ID=

# Google Chat Webhook
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=XXXXX&token=XXXXX

# Alertmanager (infra/alertmanager/alertmanager.yml) — onde o Alertmanager
# despeja os alertas do Prometheus. ATENÇÃO: o payload nativo do webhook do
# Alertmanager NÃO é compatível com o Google Chat ({"text":...}); aponte esta
# URL para um BRIDGE/adaptador que reformate o payload, NUNCA direto para a URL
# do Google Chat. Vazio = receiver noop; scripts/deploy.sh renderiza o template
# infra/alertmanager/alertmanager.webhook.yml.template quando esta URL existir.
ALERTMANAGER_WEBHOOK_URL=
METRICS_ALLOW_PRIVATE_NETWORKS=true

# Proxy / client-IP trust (apps/api/src/app.ts).
# Controls what Express treats as the real client IP from X-Forwarded-For.
# Default 'loopback' (secure): only a proxy on the same host is trusted, so a
# client cannot spoof X-Forwarded-For to forge req.ip.
# When the reverse proxy is NOT on loopback (e.g. a separate nginx/LB hop), set
# this to the number of trusted proxy hops (e.g. '1') — or an Express
# trust-proxy expression like '10.0.0.0/8' — otherwise per-IP rate limiting and
# the /metrics allow-list see the proxy's IP instead of the real client.
# NEVER use 'true' in production (it trusts every proxy and lets any client
# forge req.ip). https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=loopback

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_RANDOM_32B_PLUS
GRAFANA_ROOT_URL=http://localhost:3030

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM='"Importação" <your-email@gmail.com>'
SMTP_SECURE=false
# Verificação do certificado TLS do relay: true em produção (default); só use
# false (explícito) se o relay interno tiver certificado self-signed
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Recipient Emails
# Optional fallback only. Prefer configuring these in Configuracoes > Destinatarios operacionais.
KIOM_EMAIL=contact@kiomglobal.com
FENICIA_EMAIL=bruna@feniciacomex.com.br,fenicia.fin@feniciacomex.com.br,csouza@feniciacomex.com.br,camila.argenton@feniciacomex.com.br
ISA_EMAIL=
# Allowlist adicional para envio de atendimentos. Aceita e-mails exatos ou dominios
# (ex.: parceiro.com.br). KIOM/FENICIA/ISA ja entram automaticamente.
COMMUNICATION_ALLOWED_RECIPIENTS=parceiro.com.br,operacao@example.com

# Odoo
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your-odoo-db
ODOO_USER=your-odoo-user
ODOO_PASSWORD=your-odoo-password

# SYDLE (Compras e Pagamentos Internacionais)
# Desligado por padrão. Quando ligado, o scheduler sincroniza a cada 15 minutos.
SYDLE_SYNC_ENABLED=false
SYDLE_BASE_URL=https://your-sydle-instance.example.com
SYDLE_API_TOKEN=your-sydle-service-token
SYDLE_PAYMENTS_PATH=/api/purchase-payments
SYDLE_AUTH_HEADER=Authorization
SYDLE_AUTH_SCHEME=Bearer
SYDLE_UPDATED_AFTER_PARAM=updatedAfter
SYDLE_PAGE_PARAM=page
SYDLE_PAGE_SIZE_PARAM=pageSize
SYDLE_PAGE_SIZE=200
SYDLE_TIMEOUT_MS=30000

# Gmail API (Shared Mailbox via Service Account - preferred method)
# Uses the same service account as Google Drive (GOOGLE_DRIVE_CLIENT_EMAIL/PRIVATE_KEY)
# Requires domain-wide delegation with scope: https://www.googleapis.com/auth/gmail.modify
GMAIL_SHARED_MAILBOX=shared-mailbox@your-domain.com

# IMAP (Email Reading - fallback if Gmail API not configured)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
EMAIL_INGESTION_ENABLED=true
EMAIL_ALLOWED_SENDERS=kiom.com.br

# Logging
LOG_LEVEL=info

# Sentry (observability — backend/api)
# Vazio = Sentry DESLIGADO (default; o init é no-op sem DSN).
# Para ativar, cole o DSN do projeto Sentry da API.
SENTRY_DSN=
# Tag de release reportada ao Sentry (default 'dev' no compose). Use a versão/SHA do deploy.
APP_VERSION=dev

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
ALLOWED_DOMAIN=your-domain.com

# Google Groups (controle de acesso - só membros do grupo podem logar)
# Email de um admin do Workspace para domain-wide delegation
GOOGLE_ADMIN_EMAIL=admin@your-domain.com
# Google Group cujos membros têm acesso ao sistema.
# Fail-closed: se vazio, NINGUÉM loga — o allow-all antigo exige opt-in explícito abaixo
GOOGLE_GROUP_ALLOWED=importacao@your-domain.com
# GOOGLE_GROUP_ALLOW_ALL_WHEN_UNSET=true

# Cert-API: ERP SQL Server (armazenar no Vault, nunca no código)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-id
WMS_ORACLE_HOST=your-wms-oracle-host
WMS_ORACLE_PORT=1521
WMS_ORACLE_SID=your-wms-sid
WMS_ORACLE_USER=your-wms-user
WMS_ORACLE_PASS=your-wms-password
ERP_PUKET_HOST=your-puket-sqlserver-host
ERP_PUKET_DB=your-puket-database
ERP_IMG_HOST=your-imaginarium-sqlserver-host
ERP_IMG_DB=your-imaginarium-database
ERP_MSSQL_USER=your-erp-user
ERP_MSSQL_PASS=your-erp-password
# Obrigatorio em producao. Use valor aleatorio forte; o web/nginx injeta no proxy /cert-api.
CERT_API_KEY=CHANGE_ME_RANDOM_32B_PLUS

# Cert-API: escrita de propriedades no Linx (PROP_PRODUTOS).
# Mantenha LINX_WRITE_ENABLED=false até confirmar as colunas via
# apps/cert-api/sql/linx_discovery.sql. Enquanto false, os certificados são
# salvos no portal mas NÃO gravados no Linx (linx_status=disabled).
LINX_WRITE_ENABLED=false
# Estrutura física de PROP_PRODUTOS (preencher conforme a descoberta):
LINX_PROP_TABLE=PROP_PRODUTOS
LINX_PROP_COL_PRODUTO=PRODUTO
LINX_PROP_COL_PROPRIEDADE=PROPRIEDADE
LINX_PROP_COL_VALOR=VALOR_PROPRIEDADE
# Resolução SKU -> código de produto. Se o SKU do portal já é o código do
# produto no Linx, use LINX_SKU_IS_PRODUTO=true (resolver vira no-op). Caso o
# SKU seja produto+cor+tamanho, deixe false e informe a tabela/colunas abaixo.
LINX_SKU_IS_PRODUTO=false
LINX_PRODUTO_TABLE=PRODUTOS
LINX_PRODUTO_COL_CODIGO=PRODUTO
LINX_PRODUTO_COL_SKU=
# Formato em que a data é gravada no VALOR_PROPRIEDADE (campo texto).
LINX_DATE_FORMAT=%d/%m/%Y

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Frontend
# Leave empty for dev (Vite proxy handles /api -> localhost:3001)
# Set to /api for Docker production build
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
