# Database
DATABASE_URL=postgresql://importacao:importacao123@localhost:5432/importacao
POSTGRES_USER=importacao
POSTGRES_PASSWORD=importacao123
POSTGRES_DB=importacao

# JWT
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# API
API_PORT=3001
NODE_ENV=development

# ── AI provider ──
# 'ialocal'  (IA_LOCAL — plataforma self-hosted on-prem, sem egress, sem API paga;
#             ver repo IA_LOCAL. Recomendado p/ documentos sensíveis.)
# 'vertex'   (Google Vertex AI — garantia contratual de NÃO-treinamento nos dados.)
# 'openrouter' (externo — NÃO usar com dado sensível sem opt-in formal.)
AI_PROVIDER=ialocal
AI_ALLOW_EXTERNAL=false

# Teto de custo MENSAL da IA em USD (0 = sem teto). Atenção: o teto diario abaixo
# e o mensal coexistem — o que estourar primeiro bloqueia. Com R$100/dia, um mes
# "cheio" daria ~R$3000; se quiser permitir R$100 TODO dia, use ~600 (≈R$3000).
# 200 (≈R$1000/mes) e o teto historico pedido pelo Nicolas (2026-05-22).
AI_MONTHLY_BUDGET_USD=200
# Teto DIARIO de custo de IA em R$ (Nicolas 2026-06-22). A IA local e gratis;
# este teto so morde providers pagos (Vertex/OpenRouter). 0 desativa.
AI_DAILY_BUDGET_BRL=100
# Taxa R$/USD para converter o teto diario. O custo real vem em USD do Vertex;
# use uma taxa CONSERVADORA (>= cambio real) para o teto em R$ nunca ser
# ultrapassado — a 5.5, R$100/dia = US$18.18/dia. Se o real subir acima disso,
# aumente este numero.
AI_BRL_PER_USD=5.5
# Limites de saida por chamada. Mantem custo previsivel no Vertex e evita
# respostas gigantes por erro de prompt/schema. Ajuste com cautela: reduzir
# demais pode truncar tabelas grandes de Invoice/PL.
AI_EXTRACTION_TABLE_MAX_OUTPUT_TOKENS=16384
AI_ESPELHO_MAX_OUTPUT_TOKENS=12288
AI_BL_MAX_OUTPUT_TOKENS=6144
AI_EXTRACTION_SMALL_MAX_OUTPUT_TOKENS=4096
AI_ANALYSIS_MAX_OUTPUT_TOKENS=1024
AI_ANALYSIS_SMALL_MAX_OUTPUT_TOKENS=512
AI_SELF_REPAIR_MAX_OUTPUT_TOKENS=768
# Cap de tokens de saida por pergunta do assistente (guarda de custo por pergunta).
ASSISTANT_MAX_OUTPUT_TOKENS=768
# Upgrade para Pro so quando a confianca do Flash vier baixa. Self-repair
# reenvia o documento para preencher campos faltantes; em provider pago fica
# desligado por padrao para nao duplicar token sem autorizacao explicita.
AI_UPGRADE_ON_LOW_CONFIDENCE=1
# Reextrai UMA vez com o modelo de upgrade quando o primário devolve algo fora
# do contrato JSON. Antes a exceção subia e o documento morria em falha
# terminal (todos os campos "-") sem o modelo melhor ser tentado. Exclusivo de
# violação de contrato: orçamento estourado e timeout não escalonam.
AI_UPGRADE_ON_CONTRACT_ERROR=1
AI_UPGRADE_CONFIDENCE_THRESHOLD=0.7
AI_UPGRADE_MIN_DELTA=0.05
AI_SELF_REPAIR=1
AI_SELF_REPAIR_PAID=0

# Vertex AI (quando AI_PROVIDER=vertex)
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
# SA dedicada com role roles/aiplatform.user (cai p/ GOOGLE_DRIVE_* se vazio).
# Habilitar a API e conceder o role (uma vez, no GCP):
#   gcloud services enable aiplatform.googleapis.com --project=SEU_PROJETO
#   gcloud projects add-iam-policy-binding SEU_PROJETO \
#     --member=serviceAccount:vertex-sa@SEU_PROJETO.iam.gserviceaccount.com \
#     --role=roles/aiplatform.user
GOOGLE_VERTEX_CLIENT_EMAIL=vertex-sa@your-project.iam.gserviceaccount.com
GOOGLE_VERTEX_PRIVATE_KEY=your-private-key

# OpenRouter (quando AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# IA_LOCAL (quando AI_PROVIDER=ialocal) — gateway OpenAI-compatible do repo IA_LOCAL.
# Modelo local é grátis: não consome AI_MONTHLY_BUDGET_USD. Extração é por IMAGEM,
# então use um VLM da família qwen3: qwen3-vl:4b (CPU) / qwen3-vl:8b (GPU) /
# qwen3-vl:2b (CPU se latência apertar). qwen3 puro é TEXTO e não lê a imagem.
# Recomendado: o build especialista 'unico-docintel' (ver repo IA_LOCAL). O token
# é o COPILOTO_GATEWAY_TOKEN do IA_LOCAL.
# SEGURANÇA (premissa): http:// só é aceitável enquanto SINGLE-HOST + ia-local-net
# isolada + gateway SEM porta publicada no host. Nesse cenário o "fio" é a bridge
# Docker no mesmo kernel (sniffar exige root no host, onde TLS não salvaria). No
# momento em que o tráfego cruzar host/VLAN/overlay multi-host, habilite TLS
# (`tls internal` no Caddy do gateway), use https:// e confie na CA via
# NODE_EXTRA_CA_CERTS — NUNCA rejectUnauthorized=false.
IA_LOCAL_BASE_URL=http://ia-local-gateway:8443/v1
IA_LOCAL_API_KEY=your-ia-local-gateway-token
IA_LOCAL_MODEL=unico-docintel
# Modelo de embeddings p/ o RAG (recupera conhecimento de domínio p/ injetar no
# prompt). bge-m3 (1024 dim) é o que o IA_LOCAL já baixa no bootstrap.
IA_LOCAL_EMBED_MODEL=bge-m3
IA_LOCAL_ALLOWED_HOSTS=ia-local-gateway
IA_LOCAL_NUM_PREDICT=1536
IA_LOCAL_NUM_CTX=8192
# Pipeline especialista (constituição + skills + RAG + defesa anti-injeção).
# Default on no provider local para documentos sensíveis.
AI_USE_SPECIALIST=1
# Timeouts por chamada ao modelo. Extração roda fora do request HTTP, então o
# local (CPU lento) ganha um teto bem maior.
AI_CHAT_TIMEOUT_MS=90000
AI_LOCAL_CHAT_TIMEOUT_MS=180000
# Timeout global por documento: se OCR/IA travar, a extração vira falha
# operacional explícita em vez de deixar a UI processando indefinidamente.
DOCUMENT_AI_EXTRACTION_TIMEOUT_MS=180000
# Teto de caracteres do texto de planilha enviado à IA. Sem ele, uma coluna
# formatada inteira faz o CSV virar centenas de milhares de linhas de vírgulas
# e estourar o timeout acima (3 dos 4 timeouts em produção eram XLSX de ~30 KB).
DOCUMENT_SPREADSHEET_MAX_CHARS=200000
# Lease distribuída por documento: deve exceder o timeout global para impedir
# entregas duplicadas da fila durante OCR/IA. Mínimo aceito pela API: 120000.
DOCUMENT_EXTRACTION_LEASE_MS=1500000
DOCUMENT_REPLAY_DEFER_DERIVED=0
# Depois desse tempo, documento ainda nao processado passa a ser exibido como erro
# operacional para parar polling infinito e liberar reprocessamento.
DOCUMENT_PROCESSING_STALE_MINUTES=30

# OCR local, opt-in, para PDFs escaneados. Requer os binários `pdftoppm`
# (Poppler) e `tesseract` instalados no container da API, incluindo os idiomas
# configurados. Em qualquer falha a extração permanece no fallback multimodal;
# nenhum documento deixa de ser processado por falta desses binários.
DOCUMENT_OCR_ENABLED=1
DOCUMENT_OCR_COMMAND=tesseract
DOCUMENT_OCR_PDF_RENDERER=pdftoppm
DOCUMENT_OCR_LANGUAGES=por+eng
DOCUMENT_OCR_TIMEOUT_MS=60000
DOCUMENT_OCR_MAX_PAGES=20

# Rasterização de PDF escaneado para PNG (só Poppler/`pdftoppm`, não usa
# tesseract). Necessária quando AI_PROVIDER não lê PDF nativamente — hoje
# ialocal e openrouter. Sem ela, um PDF escaneado ia para o modelo como
# `data:application/pdf;base64,...`, que esses providers não decodificam, e a
# extração voltava com quase todos os campos vazios ("-" na tela).
# 0 desativa; nesse caso o documento falha com motivo explícito em vez de vir
# vazio. Vertex lê PDF direto e nem passa por aqui.
DOCUMENT_PDF_RASTERIZE_ENABLED=1
DOCUMENT_PDF_RASTERIZE_MAX_PAGES=8
DOCUMENT_PDF_RASTERIZE_DPI=150
DOCUMENT_PDF_RASTERIZE_TIMEOUT_MS=120000

# Google Drive
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=your-private-key
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id
# ID da pasta do Drive com a planilha Pre-Cons. A pasta precisa estar
# compartilhada (Viewer) com a SA em GOOGLE_DRIVE_CLIENT_EMAIL, senão a
# sync de Pre-Cons (*/6h) é pulada silenciosamente.
GOOGLE_DRIVE_PRE_CONS_FOLDER_ID=

# ── Referências de processo (planilha Follow Up) ─────────────────────────
# ID da planilha Follow Up. A coluna A é a lista de referências de processo e,
# com PROCESS_REFERENCE_SOURCE=follow_up, é a AUTORIDADE sobre o que é uma
# referência válida. A planilha precisa estar compartilhada (ao menos Viewer)
# com a SA em GOOGLE_DRIVE_CLIENT_EMAIL.
GOOGLE_SHEETS_FOLLOW_UP_ID=
# Nome explícito da aba; não omitir, porque abas auxiliares/ocultas podem ser
# a primeira grade da planilha e não contêm as referências operacionais.
GOOGLE_SHEETS_FOLLOW_UP_TAB=Processos

# follow_up (padrão) = só entra como processo o código declarado na coluna A da
#   planilha Follow Up. Regex e IA continuam propondo candidatos, mas a planilha
#   decide — é o que impede código de item e referência truncada de virarem
#   processo (pedido da Eduarda, 17/08/2026).
# legacy = comportamento anterior (regex/IA sobre o e-mail, com match por
#   substring). Use para voltar atrás quando a automação por e-mail for retomada.
PROCESS_REFERENCE_SOURCE=follow_up
# Validade do cache do allow-list em ms (padrão 600000 = 10 min).
FOLLOW_UP_REFERENCE_TTL_MS=

# 0 = nunca cria processo automaticamente a partir de e-mail, só alerta o
# operador. Vale mesmo para código que consta na planilha.
FOLLOW_UP_AUTO_CREATE=1

# ── Origem dos documentos do processo ────────────────────────────────────
# email = anexos chegam pelo e-mail; o Drive é backup.
# drive (padrão operacional) = considera SOMENTE o que está na pasta do processo no Drive (varredura
#   a cada 10 min). Exige GOOGLE_DRIVE_ROOT_FOLDER_ID real e a pasta raiz
#   compartilhada com a SA em GOOGLE_DRIVE_CLIENT_EMAIL. Com 'drive' a
#   ingestão por e-mail para sozinha, sem mexer em EMAIL_INGESTION_ENABLED.
# both = as duas fontes ao mesmo tempo.
DOCUMENT_SOURCE=drive
# Teto por arquivo lido do Drive (padrão 26214400 = 25 MB).
DRIVE_INGESTION_MAX_FILE_BYTES=

# Google Chat Webhook
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=XXXXX&token=XXXXX

# Alertmanager (infra/alertmanager/alertmanager.yml) — onde o Alertmanager
# despeja os alertas do Prometheus. ATENÇÃO: o payload nativo do webhook do
# Alertmanager NÃO é compatível com o Google Chat ({"text":...}); aponte esta
# URL para um BRIDGE/adaptador que reformate o payload, NUNCA direto para a URL
# do Google Chat. Vazio = receiver noop; scripts/deploy.sh renderiza o template
# infra/alertmanager/alertmanager.webhook.yml.template quando esta URL existir.
ALERTMANAGER_WEBHOOK_URL=
METRICS_ALLOW_PRIVATE_NETWORKS=true

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_RANDOM_32B_PLUS
GRAFANA_ROOT_URL=http://localhost:3030

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER/SMTP_PASS autenticam no relay. NAO definem o remetente: o header
# From vem de smtp_from (Configuracoes > E-mails > SMTP), depois de SMTP_FROM e,
# se nada estiver configurado, de "Uni.co Importacao" <global@grupounico.com>.
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM='"Uni.co Importação" <global@grupounico.com>'
SMTP_SECURE=false
# Verificação do certificado TLS do relay: true em produção (default); só use
# false (explícito) se o relay interno tiver certificado self-signed
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Recipient Emails
# Optional fallback only. Prefer configuring these in Configuracoes > Destinatarios operacionais.
KIOM_EMAIL=contact@kiomglobal.com
FENICIA_EMAIL=bruna@feniciacomex.com.br,fenicia.fin@feniciacomex.com.br,csouza@feniciacomex.com.br,camila.argenton@feniciacomex.com.br
ISA_EMAIL=
# Allowlist adicional para envio de atendimentos. Aceita e-mails exatos ou dominios
# (ex.: parceiro.com.br). KIOM/FENICIA/ISA ja entram automaticamente.
COMMUNICATION_ALLOWED_RECIPIENTS=parceiro.com.br,operacao@example.com
# Copia obrigatoria de TODO e-mail enviado pelo sistema (atendimentos e jobs).
# Fallback de Configuracoes > E-mails > Copia fixa. global@grupounico.com entra
# sempre, mesmo que esta lista aponte para outros enderecos.
COMMUNICATION_DEFAULT_CC=global@grupounico.com
# Compatibilidade legada. A caixa operacional permanece explicitamente no CC
# mesmo quando também é o remetente; só é removida se já estiver no destinatário.
MAIL_FORCE_OPERATIONAL_CC=false

# Odoo
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your-odoo-db
ODOO_USER=your-odoo-user
ODOO_PASSWORD=your-odoo-password

# SYDLE (Compras e Pagamentos Internacionais)
# Desligado por padrão. Quando ligado, o scheduler sincroniza a cada 10 minutos.
SYDLE_SYNC_ENABLED=false
SYDLE_SOURCE_TYPE=generic
SYDLE_BASE_URL=https://your-sydle-instance.example.com
SYDLE_API_TOKEN=your-sydle-service-token
SYDLE_PAYMENTS_PATH=/api/purchase-payments
SYDLE_AUTH_HEADER=Authorization
SYDLE_AUTH_SCHEME=Bearer
SYDLE_UPDATED_AFTER_PARAM=updatedAfter
SYDLE_PAGE_PARAM=page
SYDLE_PAGE_SIZE_PARAM=pageSize
SYDLE_PAGE_SIZE=200
SYDLE_TIMEOUT_MS=30000

# Sydle One class mode (SYDLE_SOURCE_TYPE=sydle_one_class)
SYDLE_APP=main
SYDLE_USER=service-account@example.com
SYDLE_PASSWORD=change-me
SYDLE_CLASS_ID=68bf1179b042c72f03993928
SYDLE_DATE_FIELD=_lastUpdateDate
SYDLE_TICKET_CLASS_ID=5d446dfc62d9656275a47d69
SYDLE_TICKET_STATUS_CLASS_ID=5cacdc04a50bfe4c0d3e5c74
SYDLE_CURRENCY_CLASS_ID=000000000000000000000059
# Enriquecimento de campos complementares (fornecedor, PI, invoice, processo, PO,
# câmbio, BRL, contrato, remessa) aflorados do request/ticket Sydle One para as
# colunas tipadas de sydle_purchase_payments. Default false. Ligue em staging só
# depois de validar o probe (scripts/sydle-class-discovery.mjs). Ver
# docs/SYDLE-ENRICHMENT-PLAN.md.
SYDLE_ONE_ENRICH_FIELDS=false
# Classes vizinhas para enriquecimento (Caso B) — overrides opcionais; os defaults
# no código apontam para a instância grupounico.sydle.one (confirmados pelo probe).
# Só usados quando SYDLE_ONE_ENRICH_FIELDS=true.
SYDLE_BRAND_CLASS_ID=685179c16732f5038aaed372
SYDLE_RECIPIENT_CLASS_ID=689cd3bd27624d322604be16
SYDLE_ENTERPRISE_CLASS_ID=591365fef5ca53284cd8d159

# Gmail API (Shared Mailbox via Service Account - preferred method)
# Uses the same service account as Google Drive (GOOGLE_DRIVE_CLIENT_EMAIL/PRIVATE_KEY)
# Requires domain-wide delegation with scope: https://www.googleapis.com/auth/gmail.modify
GMAIL_SHARED_MAILBOX=global@grupounico.com

# IMAP (Email Reading - fallback if Gmail API not configured)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# true usa TLS implícito (padrão da porta 993). false permite STARTTLS quando o
# servidor oferece a extensão; não use IMAP em texto puro fora de testes locais.
IMAP_SECURE=true
# Mantenha true em produção. false serve apenas para um servidor local isolado
# com certificado self-signed (por exemplo, o harness E2E).
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
EMAIL_INGESTION_ENABLED=true
EMAIL_ALLOWED_SENDERS=kiom.com.br
# Lease para retomar uma mensagem que ficou em "processing" após crash. Uma
# lease ainda ativa nunca é marcada como lida por outro worker.
EMAIL_PROCESSING_STALE_MINUTES=30
# Limite de caracteres do corpo textual persistido por e-mail ingerido (default 20000)
EMAIL_BODY_MAX_CHARS=20000

# Logging
LOG_LEVEL=info

# Sentry (observability — backend/api)
# Vazio = Sentry DESLIGADO (default; o init é no-op sem DSN).
# Para ativar, cole o DSN do projeto Sentry da API.
SENTRY_DSN=
# Tag de release reportada ao Sentry (default 'dev' no compose). Use a versão/SHA do deploy.
APP_VERSION=dev

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
ALLOWED_DOMAIN=your-domain.com

# Google Groups (controle de acesso - só membros do grupo podem logar)
# Email de um admin do Workspace para domain-wide delegation
GOOGLE_ADMIN_EMAIL=admin@your-domain.com
# Google Group cujos membros têm acesso ao sistema.
# Fail-closed: se vazio, NINGUÉM loga — o allow-all antigo exige opt-in explícito abaixo
GOOGLE_GROUP_ALLOWED=importacao@your-domain.com
# GOOGLE_GROUP_ALLOW_ALL_WHEN_UNSET=true

# Cert-API: ERP SQL Server (armazenar no Vault, nunca no código)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-id
WMS_ORACLE_HOST=your-wms-oracle-host
WMS_ORACLE_PORT=1521
WMS_ORACLE_SID=your-wms-sid
WMS_ORACLE_USER=your-wms-user
WMS_ORACLE_PASS=your-wms-password
ERP_PUKET_HOST=your-puket-sqlserver-host
ERP_PUKET_DB=your-puket-database
ERP_IMG_HOST=your-imaginarium-sqlserver-host
ERP_IMG_DB=your-imaginarium-database
# Credenciais por marca: db01 (Puket) e db02 (Imaginarium) sao instancias SQL Server
# SEPARADAS, com logins separados — uma credencial so nao atende as duas.
ERP_PUKET_USER=your-puket-erp-user
ERP_PUKET_PASS=your-puket-erp-password
ERP_IMG_USER=your-imaginarium-erp-user
ERP_IMG_PASS=your-imaginarium-erp-password
# Fallback usado quando as credenciais por marca acima nao estao definidas
# (serve so se o mesmo login valer para as duas bases).
ERP_MSSQL_USER=your-erp-user
ERP_MSSQL_PASS=your-erp-password
# Obrigatorio em producao. Use valor aleatorio forte; o web/nginx injeta no proxy /cert-api.
CERT_API_KEY=CHANGE_ME_RANDOM_32B_PLUS

# Cert-API: escrita de propriedades no Linx (PROP_PRODUTOS).
# Enquanto false, os certificados são salvos no portal mas NÃO gravados no Linx
# (linx_status=disabled). Schema confirmado contra as duas bases em 2026-07-16;
# ver docs/CERT-LINX-WRITE.md §6 antes de ligar.
LINX_WRITE_ENABLED=false
# Estrutura física de PROP_PRODUTOS — os valores abaixo são o schema REAL das duas bases.
LINX_PROP_TABLE=PROP_PRODUTOS
LINX_PROP_COL_PRODUTO=PRODUTO
LINX_PROP_COL_PROPRIEDADE=PROPRIEDADE
LINX_PROP_COL_VALOR=VALOR_PROPRIEDADE
# 3a coluna da PK, smallint NOT NULL e sem default: o INSERT precisa informá-la.
# As props de certificado são single-valued e usam item=1 em todas as linhas existentes.
LINX_PROP_COL_ITEM=ITEM_PROPRIEDADE
LINX_PROP_ITEM_VALUE=1
# Resolução SKU -> código de produto. Confirmado em 2026-07-16: o SKU do portal JÁ é o
# código do produto nas duas marcas (070400034 no Puket, PI4511Y no Imaginarium), então
# o go-live usa true. Deixe false + informe as colunas abaixo se algum SKU passar a ser
# produto+cor+tamanho.
LINX_SKU_IS_PRODUTO=false
LINX_PRODUTO_TABLE=PRODUTOS
LINX_PRODUTO_COL_CODIGO=PRODUTO
LINX_PRODUTO_COL_SKU=
# Formato em que a data é gravada no VALOR_PROPRIEDADE (campo texto).
LINX_DATE_FORMAT=%d/%m/%Y

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Frontend
# Leave empty for dev (Vite proxy handles /api -> localhost:3001)
# Set to /api for Docker production build
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
