# =============================================================================
# .env.sops.yaml.example — Template for SOPS-encrypted environment secrets
# =============================================================================
# INSTRUCTIONS:
#   1. cp .env.sops.yaml.example .env.sops.yaml
#   2. Fill in all values
#   3. Encrypt: sops --encrypt --in-place .env.sops.yaml
#   4. Commit .env.sops.yaml (encrypted) and .sops.yaml
#   5. Decrypt to .env: bash scripts/generate-env-from-vault.sh --sops
#
# NEVER commit .env or unencrypted .env.sops.yaml
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER: importacao
POSTGRES_PASSWORD: CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB: importacao

# --- API ---
JWT_SECRET: CHANGE_ME_MINIMUM_32_CHARS_RANDOM
JWT_EXPIRES_IN: 24h
NODE_ENV: production
LOG_LEVEL: info
SENTRY_DSN: ""
METRICS_ALLOW_PRIVATE_NETWORKS: "true"

# --- Google / AI ---
# AI_PROVIDER: 'ialocal' por default; 'vertex'/'openrouter' exigem AI_ALLOW_EXTERNAL=true.
AI_PROVIDER: ialocal
AI_ALLOW_EXTERNAL: "false"
AI_MONTHLY_BUDGET_USD: "200"
OPENROUTER_API_KEY: ""
OPENROUTER_BASE_URL: https://openrouter.ai/api/v1
# IA_LOCAL — gateway OpenAI-compatible do projeto IA_LOCAL.
AI_USE_SPECIALIST: "1"
IA_LOCAL_BASE_URL: http://ia-local-gateway:8443/v1
IA_LOCAL_API_KEY: ""
IA_LOCAL_MODEL: unico-docintel
IA_LOCAL_EMBED_MODEL: bge-m3
IA_LOCAL_ALLOWED_HOSTS: ia-local-gateway
DOCUMENT_AI_EXTRACTION_TIMEOUT_MS: "180000"
DOCUMENT_PROCESSING_STALE_MINUTES: "30"
# Vertex AI — obrigatório GOOGLE_VERTEX_PROJECT quando AI_PROVIDER=vertex.
# Credenciais caem para GOOGLE_DRIVE_CLIENT_EMAIL/PRIVATE_KEY se as GOOGLE_VERTEX_* ficarem vazias.
GOOGLE_VERTEX_PROJECT: ""
GOOGLE_VERTEX_LOCATION: us-central1
GOOGLE_VERTEX_CLIENT_EMAIL: ""
GOOGLE_VERTEX_PRIVATE_KEY: ""
GOOGLE_DRIVE_CLIENT_EMAIL: ""
GOOGLE_DRIVE_PRIVATE_KEY: ""
GOOGLE_DRIVE_ROOT_FOLDER_ID: ""
GOOGLE_CHAT_WEBHOOK_URL: ""
GOOGLE_CLIENT_ID: ""
GOOGLE_ADMIN_EMAIL: ""
GOOGLE_GROUP_ALLOWED: CHANGE_ME_GOOGLE_GROUP_EMAIL
GOOGLE_SHEETS_SPREADSHEET_ID: ""
ALERTMANAGER_WEBHOOK_URL: ""
GRAFANA_ADMIN_PASSWORD: CHANGE_ME_RANDOM_32B_PLUS
GRAFANA_ROOT_URL: ""

# --- SMTP ---
SMTP_HOST: mta.imgnet.com.br
SMTP_PORT: 2525
SMTP_USER: ""
SMTP_PASS: ""
SMTP_FROM: global@grupounico.com
SMTP_SECURE: "false"
# Optional fallback only. Prefer Configuracoes > Destinatarios operacionais.
KIOM_EMAIL: ""
FENICIA_EMAIL: ""
ISA_EMAIL: ""
# Additional send allowlist for exact e-mails or domains. Operational recipients
# above are always allowed; keep empty only after configuring recipients in-app.
COMMUNICATION_ALLOWED_RECIPIENTS: ""

# --- Gmail ingestion ---
GMAIL_SHARED_MAILBOX: ""
EMAIL_INGESTION_ENABLED: "false"
EMAIL_ALLOWED_SENDERS: ""

# --- Frontend ---
VITE_API_URL: ""
VITE_GOOGLE_CLIENT_ID: ""

# --- App config ---
ALLOWED_DOMAIN: grupounico.com
CORS_ORIGIN: "https://importacao.grupounico.com"
TRUST_PROXY: "1"

# --- Odoo ---
ODOO_URL: ""
ODOO_DB: ""
ODOO_USER: ""
ODOO_PASSWORD: ""

# --- SYDLE purchase/payment report ---
SYDLE_SYNC_ENABLED: "false"
SYDLE_SOURCE_TYPE: "generic"
SYDLE_BASE_URL: ""
SYDLE_API_TOKEN: ""
SYDLE_PAYMENTS_PATH: "/api/purchase-payments"
SYDLE_AUTH_HEADER: "Authorization"
SYDLE_AUTH_SCHEME: "Bearer"
SYDLE_UPDATED_AFTER_PARAM: "updatedAfter"
SYDLE_PAGE_PARAM: "page"
SYDLE_PAGE_SIZE_PARAM: "pageSize"
SYDLE_PAGE_SIZE: "200"
SYDLE_TIMEOUT_MS: "30000"
SYDLE_APP: "main"
SYDLE_USER: ""
SYDLE_PASSWORD: ""
SYDLE_CLASS_ID: "68bf1179b042c72f03993928"
SYDLE_DATE_FIELD: "_lastUpdateDate"
SYDLE_TICKET_CLASS_ID: "5d446dfc62d9656275a47d69"
SYDLE_TICKET_STATUS_CLASS_ID: "5cacdc04a50bfe4c0d3e5c74"
SYDLE_CURRENCY_CLASS_ID: "000000000000000000000059"
# Caso B (enriquecimento da 2a tabela) — classes vizinhas confirmadas pelo probe.
SYDLE_BRAND_CLASS_ID: "685179c16732f5038aaed372"
SYDLE_RECIPIENT_CLASS_ID: "689cd3bd27624d322604be16"
SYDLE_ENTERPRISE_CLASS_ID: "591365fef5ca53284cd8d159"
# Liga processCode/invoiceNumber/brand/supplierName (requestData + classes vizinhas).
# Mudar para "true" para destravar a conciliação. Ver docs/SYDLE-ENRICHMENT-PLAN.md.
SYDLE_ONE_ENRICH_FIELDS: "false"

# --- WMS / ERP ---
WMS_ORACLE_HOST: ""
WMS_ORACLE_PORT: ""
WMS_ORACLE_SID: ""
WMS_ORACLE_USER: ""
WMS_ORACLE_PASS: CHANGE_ME
ERP_PUKET_HOST: ""
ERP_PUKET_DB: ""
ERP_IMG_HOST: ""
ERP_IMG_DB: ""
ERP_MSSQL_USER: ""
ERP_MSSQL_PASS: CHANGE_ME
CERT_API_KEY: CHANGE_ME_RANDOM_API_KEY

# --- Linx write-back (cert-api) ---
LINX_WRITE_ENABLED: "false"
LINX_PROP_TABLE: PROP_PRODUTOS
LINX_PROP_COL_PRODUTO: PRODUTO
LINX_PROP_COL_PROPRIEDADE: PROPRIEDADE
LINX_PROP_COL_VALOR: VALOR_PROPRIEDADE
LINX_SKU_IS_PRODUTO: "false"
LINX_PRODUTO_TABLE: PRODUTOS
LINX_PRODUTO_COL_CODIGO: PRODUTO
LINX_PRODUTO_COL_SKU: ""
LINX_DATE_FORMAT: "%d/%m/%Y"
