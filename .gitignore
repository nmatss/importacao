# Local dotcontext runtime/session traces are registered by the harness provider,
# not shipped with application releases.
.context/runtime/

# SOPS encrypted file.
# Ignored to avoid accidental plaintext adds; the encrypted production file is
# intentionally tracked with `git add -f .env.sops.yaml`.
.env.sops.yaml

# Service-account / credential keys — NUNCA commitar
*-key.json
*service-account*.json
*gemini*.json
*credentials*.json
gcp-*.json

# Texto extraído de .docx/.xlsx para revisão (derivado — não versionar)
docs/_extracted/

# Deploy artifacts
deploy.log
scripts/deploy.sh.backup
.claude/worktrees/

# Uploaded certificate PDFs (cert-api runtime data)
apps/cert-api/certs/

# Python bytecode (cert-api)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Python virtualenv (cert-api)
apps/cert-api/.venv/

# Saidas de execucao de teste (Playwright). Ficavam rastreadas e sujavam
# o diff a cada rodada.
test-results/
playwright-report/
# Arquivos temporarios que o CLI escreve ao salvar settings locais; um deles
# chegou a ser versionado por acidente.
.claude/settings.local.json.tmp.*
